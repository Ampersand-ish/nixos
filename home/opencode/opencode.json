{
  "$schema": "https://opencode.ai",
  "model": "ollama/gemma:12b",
  "small_model": "ollama/gemma:12b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma:12b": {}
      }
    }
  },
  "plugin": [
    [
      "opencode-conductor-plugin",
      {
        "strategy": "dynamic_routing",
        "routing_threshold": 0.65,
        "fallback_to_small_model": true,
        "slots": {
          "tool_calling": "model",
          "planning_and_reasoning": "ollama/gemma:12b"
        }
      }
    ]
  ]
}
