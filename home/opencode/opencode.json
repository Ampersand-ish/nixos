{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-pro-0813",
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "default_agent": "build",
  "share": "disabled",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "deepseek/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 1.1,
            "output": 3.3
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "medium"
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 3.0,
            "output": 15.0
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "high"
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 0.07,
            "output": 0.18
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "low"
            }
          }
        },
        "z-ai/glm-5.3": {
          "name": "GLM-5.3 (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 1.4,
            "output": 4.4
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "medium"
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 0.07,
            "output": 0.25
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "low"
            }
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 0.71,
            "output": 3.5
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "medium"
            }
          }
        },
        "minimax/minimax-m3": {
          "name": "MiniMax M3 (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 0.3,
            "output": 1.2
          },
          "options": {
            "provider": {
              "zdr": true,
              "data_collection": "deny"
            },
            "reasoning": {
              "effort": "medium"
            }
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openrouter/deepseek/deepseek-v4-pro-0813",
      "description": "Default coding agent: implements changes with full tool access"
    },
    "plan": {
      "model": "openrouter/moonshotai/kimi-k3",
      "description": "Read-only planning and hard-problem analysis on the strongest model",
      "permission": {
        "edit": {
          "*": "deny",
          "*.opencode/plans/*.md": "allow",
          "*/.local/share/opencode/plans/*.md": "allow"
        }
      }
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "description": "Fast, cheap read-only codebase exploration",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "allow",
          "rm *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny"
        }
      }
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "description": "Cheap general-purpose subagent for parallel research and small edits"
    },
    "review": {
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k3",
      "description": "Reviews a diff for correctness bugs and missed edge cases; read-only",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        }
      },
      "prompt": "You are a senior code reviewer. Read the requested diff or files and report concrete correctness bugs, unhandled edge cases, and behavioral regressions. For each finding give file:line, what breaks, and a minimal fix. Do not restyle code. Do not report nitpicks. If you find nothing wrong, say so plainly."
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git blame*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "tree*": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "sed -n *": "allow",
      "rm -rf /*": "deny",
      "git push --force*": "deny"
    }
  },
  "compaction": {
    "auto": true
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
