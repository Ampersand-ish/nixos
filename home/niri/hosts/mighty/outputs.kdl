// Output configuration for mighty (MSI MPG321URX OLED, single monitor).
// Contributed via desktop.niri.outputs.
// hdr/max-bpc stripped: is the residual screen-space artifact from the spicy HDR/10-bit path?

output "Microstep MPG321UX OLED 0x01010101" {
    mode "3840x2160@239.990"
    scale 1.5
    transform "normal"
    position x=0 y=0
    variable-refresh-rate on-demand=true
}
