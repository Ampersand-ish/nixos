// Output configuration for mighty (MSI MPG321URX OLED, single monitor).
// Contributed via desktop.niri.outputs; the HDR/max-bpc nodes are spicy-niri syntax.

output "Microstep MPG321UX OLED 0x01010101" {
    mode "3840x2160@239.990"
    scale 1.5
    transform "normal"
    position x=0 y=0
    variable-refresh-rate on-demand=true
    max-bpc 10
    // ISOLATION TEST: HDR signalling off (8-bit scanout already ruled out via NIRI_HDR_FORCE_8BIT).
    // hdr mode="auto" {
    //     reference-luminance 203
    // }
}
