// =============================================================================
// Niri Main Configuration File (KDL Format)
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// =============================================================================

// -----------------------------------------------------------------------------
// Autostart & Environment
// -----------------------------------------------------------------------------

spawn-at-startup "dbus-update-activation-environment" "--all"
// udiskie is started by home-manager (services.udiskie)

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}

// -----------------------------------------------------------------------------
// System & General Settings
// -----------------------------------------------------------------------------

config-notification {
    disable-failed
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
}

// -----------------------------------------------------------------------------
// Input Devices & Gestures
// -----------------------------------------------------------------------------

input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
        scroll-factor 0.75
    }

    trackpoint
}

gestures {
    hot-corners {
        off
    }
}

// -----------------------------------------------------------------------------
// Cursor Settings
// -----------------------------------------------------------------------------

cursor {
    xcursor-theme "capitaine-cursors"
    xcursor-size 36
}

// -----------------------------------------------------------------------------
// Output / Display Monitor Configurations: per host, see home/niri/hosts/<host>/outputs.kdl
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// Layout & Appearance
// -----------------------------------------------------------------------------

layout {
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
        width 2
    }

    border {
        off
        width 2
    }

    shadow {
        on
        softness 8
        spread 1
        offset x=0 y=0
        draw-behind-window true
        color "#121212"
        inactive-color "#00000000"
    }
}

// -----------------------------------------------------------------------------
// Animations
// -----------------------------------------------------------------------------

animations {
    workspace-switch {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    window-close {
        duration-ms 150
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    horizontal-view-movement {
        duration-ms 200
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    window-movement {
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    window-resize {
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.42 0.0 0.58 1.0
    }

    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }

    slowdown 0.8
}

// -----------------------------------------------------------------------------
// Recent Windows / Alt+Tab
// -----------------------------------------------------------------------------

recent-windows {
    highlight {
        corner-radius 16
    }

    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// -----------------------------------------------------------------------------
// Workspace Overview
// -----------------------------------------------------------------------------

overview {
    workspace-shadow {
        off
    }
}

// -----------------------------------------------------------------------------
// Window & Layer Rules
// -----------------------------------------------------------------------------

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        xray false
    }
}
window-rule {
    match app-id=r"^org\.gnome\."
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

// Fixed size / Non-floating control panels
window-rule {
    match app-id=r"^gnome-control-center$"
    match app-id=r"^pavucontrol$"
    match app-id=r"^nm-connection-editor$"
    default-column-width { proportion 0.5; }
    open-floating false
}

// Floating dialogs and tools
window-rule {
    match app-id=r"^org\.gnome\.Calculator$"
    match app-id=r"^gnome-calculator$"
    match app-id=r"^galculator$"
    match app-id=r"^blueman-manager$"
    match app-id=r"^org\.gnome\.Nautilus$"
    match app-id=r"^xdg-desktop-portal$"
    open-floating true
}

// Firefox PiP & Zoom floating
window-rule {
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

// Web Browser maximization
window-rule {
    match app-id="^google-chrome$"
    open-maximized true
}

// Steam notification toasts position
window-rule {
    match app-id=r"^steam$" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// Steam games open full screen always	
window-rule {
    match app-id=r"^steam_app_\d+$"
    open-fullscreen true
}

// Terminal & Browser border rendering
window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
    opacity 0.95
    background-effect {
        xray false
        blur true
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.03
    saturation 1.0
}

// -----------------------------------------------------------------------------
// Keybindings
// -----------------------------------------------------------------------------

// The `binds` node is assembled by modules/desktop/niri.nix from
// binds-common.kdl + binds-noctalia.kdl / binds-dms.kdl (build-time selection).

// The host output blocks, the per-shell fragment (shell-noctalia.kdl or
// shell-dms.kdl) and the assembled `binds` node are added by
// modules/desktop/niri.nix.
